{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "isolatedModules": true, "skipLibCheck": true,
    "declaration": true, "noEmit": true, "resolveJsonModule": true
  },
  "include": ["src", "test/*.ts", "tsup.config.ts"]
}
